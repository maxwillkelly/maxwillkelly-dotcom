# Resend API key for sending contact emails
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=your_resend_key_here

# Verified sender email address (must be verified in Resend)
SEND_EMAIL=you@domain.com

# Upstash Redis REST URL (used for rate limiting and PDF caching)
# Get yours at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io

# Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# PDF filename when downloaded
NEXT_PUBLIC_PDF_FILENAME="Max Kelly - CV.pdf"

# Maximum PDF lifetime in seconds
PDF_CACHE_LIFETIME_SECONDS=14400 # 4 hours

# Maximum PDF size in bytes
PDF_MAXIMUM_SIZE_BYTES=4000000 # 4 MB

# Maximum PDF downloads per IP address within the sliding window
PDF_RATE_LIMIT_REQUESTS=5

# PDF rate limit sliding window (Upstash duration: ms, s, m, h, d or w)
PDF_RATE_LIMIT_WINDOW_DURATION="1 m"

# PDF rate limit Redis request timeout in milliseconds
PDF_RATE_LIMIT_TIMEOUT_MS=3000

# Overall render deadline after browser launch in milliseconds
PDF_RENDER_TIMEOUT_MS=45000

# Browser launch, protocol, navigation, asset and PDF operation timeout in milliseconds
PDF_OPERATION_TIMEOUT_MS=15000

# Browser shutdown grace period in milliseconds before forced termination
PDF_BROWSER_CLOSE_TIMEOUT=3000
